# Copy to .env (never commit .env) and fill in before going live.
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql://user:password@host:5432/eventouse
SESSION_COOKIE_SECURE=1
# console (development) or your SMS provider once wired in app/sms.py
SMS_PROVIDER=console

# Behind a proxy (Render, Nginx...): use X-Forwarded-For for per-IP rate limits
# TRUSTED_PROXY=1
# Eventouse staff who can open /admin (comma-separated, with +91)
# ADMIN_PHONES=+919876543210
